meta {
  name: 02 Consultar elegibilidade pelo Location (200)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/elegibilidades/{{protocolo}}
  body: none
  auth: none
}

tests {
  test("recupera o pedido aceito com 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("o protocolo consultado e o mesmo criado no passo 01", function () {
    expect(res.body.protocolo).to.equal(bru.getEnvVar("protocolo"));
  });
}
