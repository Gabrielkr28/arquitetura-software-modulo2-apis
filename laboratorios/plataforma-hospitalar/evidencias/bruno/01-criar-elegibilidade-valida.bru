meta {
  name: 01 Criar elegibilidade (202)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/elegibilidades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cpf": "12345678901",
    "codigo_operadora": "OPS-001",
    "matricula_plano": "MAT-2026-001"
  }
}

script:post-response {
  bru.setEnvVar("protocolo", res.body.protocolo);
  bru.setEnvVar("location", res.getHeader("location"));
}

tests {
  test("aceita o pedido com 202", function () {
    expect(res.getStatus()).to.equal(202);
  });

  test("devolve Location apontando para o recurso aceito", function () {
    expect(res.getHeader("location")).to.equal("/elegibilidades/" + res.body.protocolo);
  });

  test("situacao inicial e recebida, nao decidida", function () {
    expect(res.body.situacao).to.equal("recebida");
  });
}
